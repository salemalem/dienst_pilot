{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dienstpilot.example/events/PreferencesSubmitted.v1",
  "title": "PreferencesSubmitted",
  "description": "A physician answered a request window. Payload carries ids only.",
  "type": "object",
  "properties": {
    "window_id": {
      "type": "string",
      "format": "uuid"
    },
    "staff_id": {
      "type": "string",
      "format": "uuid"
    },
    "entries": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "window_id",
    "staff_id",
    "entries"
  ],
  "additionalProperties": false
}
