{
  "name": "dienstpilot",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "pnpm --filter @dienstpilot/design-tokens build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @dienstpilot/dashboard --filter @dienstpilot/mobile dev",
    "lint": "pnpm build:packages && eslint . && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
