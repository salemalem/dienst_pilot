{
  "name": "@dienstpilot/screenshots",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright capture of the portfolio screenshots (UI_SPEC \u00a76) and the side-by-side comparison with the design reference.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "capture": "MODE=capture playwright test -c playwright.config.ts",
    "compare": "MODE=compare E2E_LANG=de playwright test -c playwright.config.ts",
    "finalize": "node src/finalize.mts"
  },
  "devDependencies": {
    "@dienstpilot/i18n": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "intl-messageformat": "^12.1.3",
    "sharp": "^0.35.5",
    "vitest": "^5.0.5"
  }
}
