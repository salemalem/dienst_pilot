import { mkdtemp, readdir, readFile, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";

import { chromium } from "@playwright/test";
import sharp from "sharp";

import { recompress } from "./compress.ts";

type Entry = { id: string; slug: string; caption: string; themes: string[] };

const ROOT = resolve(process.cwd(), "../..");
const OUT = join(ROOT, "screenshots");
const LANGS = ["de", "en"] as const;

const manifest = JSON.parse(await readFile(join(OUT, "manifest.json"), "utf8")) as Entry[];

// 1. Lossless re-encode of every image (never the contact sheets: they are made from the result).
let before = 0;
let after = 0;
for (const lang of LANGS) {
  for (const theme of ["light", "dark"]) {
    const dir = join(OUT, lang, theme);
    const files = await readdir(dir).catch(() => [] as string[]);
    for (const f of files.filter((n) => n.endsWith(".png"))) {
      const src = await readFile(join(dir, f));
      const out = await recompress(src);
      before += src.length;
      after += out.length;
      if (out !== src) await writeFile(join(dir, f), out);
    }
  }
}

// 2. One contact sheet per language: thumbnails with their ids, dashboard screens, then phone screens.
const browser = await chromium.launch();
const tmp = await mkdtemp(join(tmpdir(), "sheet-"));
for (const lang of LANGS) {
  const wide: string[] = [];
  const phone: string[] = [];
  for (const theme of ["light", "dark"]) {
    for (const e of manifest.filter((m) => m.themes.includes(theme))) {
      const file = join(OUT, lang, theme, `${e.id}-${e.slug}.png`);
      const meta = await sharp(file).metadata();
      const card = `<figure><img src="${pathToFileURL(file).href}"><figcaption><b>${e.id}</b> ${e.slug} · ${theme}</figcaption></figure>`;
      ((meta.width ?? 0) > 2000 ? wide : phone).push(card);
    }
  }
  const html = join(tmp, `${lang}.html`);
  await writeFile(
    html,
    `<!doctype html><meta charset="utf-8"><style>
    body{margin:0;padding:24px;background:#e6eaee;font:14px system-ui;color:#1c2b36;width:1752px}
    h1{font-size:20px;margin:0 0 16px}
    main{display:grid;gap:16px;align-items:start;margin-bottom:32px}
    main.wide{grid-template-columns:repeat(3,1fr)}
    main.phone{grid-template-columns:repeat(6,1fr)}
    figure{margin:0}
    img{width:100%;display:block;border:1px solid #b7c0c8;background:#fff}
    figcaption{padding-top:4px}
  </style><h1>DienstPilot, ${lang === "de" ? "Deutsch" : "English"} (synthetic data)</h1>
  <main class="wide">${wide.join("")}</main><main class="phone">${phone.join("")}</main>`,
  );
  const page = await browser.newPage({ viewport: { width: 1800, height: 1000 } });
  await page.goto(pathToFileURL(html).href);
  await page.waitForFunction(() =>
    [...document.images].every((i) => i.complete && i.naturalWidth > 0),
  );
  await page.screenshot({ path: join(OUT, lang, "contact-sheet.png"), fullPage: true });
  await page.close();
}
await rm(tmp, { recursive: true, force: true });
await browser.close();
const sheets = await Promise.all(
  LANGS.map(async (l) => {
    const p = join(OUT, l, "contact-sheet.png");
    const src = await readFile(p);
    const out = await recompress(src);
    if (out !== src) await writeFile(p, out);
  }),
);
void sheets;

// 3. INDEX.md from the manifest.
const lines = [
  "# Screenshots",
  "",
  "Generated by `make screenshots` from a clean seed (demo clock 06:00, 06:43 for Situation C). All data is synthetic (fictional Klinik für Innere Medizin, Klinikum Musterstadt). Captions are in English; each image exists in German and English.",
  "",
  "Contact sheets: [Deutsch](de/contact-sheet.png), [English](en/contact-sheet.png).",
  "",
  "| ID | Light | Dark | Caption |",
  "|---|---|---|---|",
];
for (const e of manifest) {
  const link = (theme: string): string =>
    e.themes.includes(theme)
      ? LANGS.map((l) => `[${l}](${l}/${theme}/${e.id}-${e.slug}.png)`).join(" · ")
      : "–";
  lines.push(`| ${e.id} | ${link("light")} | ${link("dark")} | ${e.caption} |`);
}
await writeFile(join(OUT, "INDEX.md"), `${lines.join("\n")}\n`);
console.log(
  `finalized ${String(manifest.length)} scenes; images ${String(before)} -> ${String(after)} bytes`,
);
