# Copy to .env for local overrides. All values here are for the local demo stack only.
DATABASE_URL=postgresql+psycopg://dienstpilot:dienstpilot@localhost:5433/dienstpilot
REDIS_URL=redis://localhost:6379/0
LLM_MODEL_INTAKE=claude-haiku-5-5
LLM_MODEL_COPILOT=claude-haiku-5-5
# auto (live with a key, else the labelled stand-ins) | live | replay (recorded fixtures) | off
# LLM_MODE=auto
# Optional: without a key, C7 and C8 run as their labelled stand-ins. Never commit a real key;
# .env is git-ignored. Only the Anthropic SDK adapter reads it.
# ANTHROPIC_API_KEY=
# The folder with the bge-m3 ONNX files for rule search (see CLAUDE.md, "Rule search model").
# Default lookup: BGE_M3_DIR, then ./models/bge-m3, then the Hugging Face cache. Absolute path.
# BGE_M3_DIR=/Users/you/dienst_pilot/models/bge-m3
# Which retrieval is served: vector (the evaluated champion), hybrid or fts.
# RAG_RETRIEVAL=vector
# Registers PUT /demo/clock (Administrator only). On in the dev stack, off otherwise.
DEMO_MODE=true
# Signs demo-login tokens. Change it anywhere but on your own machine.
TOKEN_SECRET=dev-only-not-a-secret
