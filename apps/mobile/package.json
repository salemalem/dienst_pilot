{
  "name": "@dienstpilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "start": "expo start --port 8081",
    "web": "expo start --web --port 8081",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "pnpm build:e2e && E2E_LANG=de playwright test && E2E_LANG=en playwright test",
    "build:e2e": "EXPO_PUBLIC_API_URL=http://localhost:8100 expo export --platform web --output-dir dist-e2e"
  },
  "dependencies": {
    "@dienstpilot/api-client": "workspace:*",
    "@dienstpilot/design-tokens": "workspace:*",
    "@dienstpilot/i18n": "workspace:*",
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.14",
    "expo-constants": "^58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "^58.0.12",
    "expo-router": "^58.0.18",
    "expo-status-bar": "~58.0.3",
    "i18next": "^26.5.0",
    "i18next-icu": "^2.6.1",
    "intl-messageformat": "^12.1.0",
    "lucide-react-native": "^1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.5"
  }
}
